OPENAI_API_KEY=...
TAVILY_API_KEY=...
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_BOOTSTRAP_ADMIN_ENABLED=true
AUTH_BOOTSTRAP_ADMIN_LOGIN_ID=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=admin1
AUTH_PASSWORD_MIN_LENGTH=15
AUTH_PASSWORD_REQUIRE_LOWERCASE=true
AUTH_PASSWORD_REQUIRE_NUMBER=true
AUTH_TOKEN_PEPPER=
AUTH_PBKDF2_ITERATIONS=150000
AUTH_SESSION_TTL_HOURS=24
AUTH_SESSION_ABSOLUTE_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_COOKIE_NAME=orch_session
AUTH_CSRF_COOKIE_NAME=orch_csrf
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
